# Observer configuration. Copy to /etc/tvtg-observer.env (systemd: install.sh does it) or ./observer.env (Docker),
# then chmod 600. One KEY=value per line. No inline comments: systemd and Docker treat them as part of the value.

# Label for this host in the dashboard, e.g. pi-home, nuc-office.
OBSERVER_NAME=pi-home

# Channels to watch (alert + canary), comma-separated.
CHAT_IDS=-1001234567890,-1009876543210

# terraform output collector_url
COLLECTOR_URL=https://example.lambda-url.us-west-2.on.aws/

# --- Secrets, option A: inline ----------------------------------------------------------------
# Your own app credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Output of: observer.py login   (use a separate login per observer host)
TG_SESSION=
# Value of the SSM parameter /tvtg-<env>/collector_key
COLLECTOR_KEY=

# --- Secrets, option B: from SSM (needs AWS credentials and requirements-aws.txt) --------------
# Leave the option A values empty; each empty one is read from SSM instead.
# OBSERVER_SSM_PREFIX=/tvtg-prod/observer
# AWS_REGION=us-west-2
# COLLECTOR_KEY_SSM=/tvtg-prod/collector_key
# COLLECTOR_KEY_SSM_REGION=us-west-2
